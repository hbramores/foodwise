{
  "name": "foodwise-ph",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "FoodWise PH \u2014 a frontend-only restaurant sales forecasting system",
  "scripts": {
    "dev": "vite",
    "build": "node node_modules/typescript/bin/tsc -b && node node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "typecheck": "node node_modules/typescript/bin/tsc -b --noEmit",
    "verify": "esbuild scripts/verify.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/foodwise-verify.mjs --log-level=error && node node_modules/.cache/foodwise-verify.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
